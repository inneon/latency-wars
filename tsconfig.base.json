{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@latency-wars/contracts": [
        "./libs/shared/contracts/src/index.ts"
      ],
      "@latency-wars/domain": [
        "./libs/shared/domain/src/index.ts"
      ],
      "@latency-wars/visibility": [
        "./libs/core/visibility/src/index.ts"
      ],
      "@latency-wars/movement": [
        "./libs/core/movement/src/index.ts"
      ],
      "@latency-wars/engagement": [
        "./libs/core/engagement/src/index.ts"
      ],
      "@latency-wars/economy": [
        "./libs/core/economy/src/index.ts"
      ],
      "@latency-wars/playtest-contracts": [
        "./libs/playtest/contracts/src/index.ts"
      ],
      "@latency-wars/playtest-replay": [
        "./libs/playtest/replay/src/index.ts"
      ],
      "@latency-wars/playtest-run-files": [
        "./libs/playtest/adapters/run-files/src/index.ts"
      ],
      "@latency-wars/map-view": [
        "./libs/map/view/src/index.ts"
      ]
    },
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
